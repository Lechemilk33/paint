# Copy to .env.local and fill in with values from:
#   npx tsx --tsconfig scripts/tsconfig.json scripts/make-credentials.ts
#
# On Netlify these are set as site environment variables instead.

# scrypt hash of the admin password. The password itself is never stored.
ADMIN_PASSWORD_HASH=

# Signing key for the admin session cookie. At least 32 random characters.
AUTH_SECRET=

# --- Payments (optional) ---------------------------------------------------
# Leave all three blank and the store runs exactly as it did before: no Buy
# button anywhere, and every piece takes email inquiries instead.
#
# From dashboard.stripe.com/apikeys. Use the test key (sk_test_...) until you
# have put a card through it.
STRIPE_SECRET_KEY=

# From the webhook endpoint you add at dashboard.stripe.com/webhooks, pointing
# at https://your-site/api/stripe/webhook and subscribed to:
#   checkout.session.completed
#   checkout.session.expired
#   checkout.session.async_payment_succeeded
#   checkout.session.async_payment_failed
# Locally, `stripe listen --forward-to localhost:3000/api/stripe/webhook`
# prints a whsec_... to use instead.
STRIPE_WEBHOOK_SECRET=

# Only needed off Netlify. Netlify sets URL and DEPLOY_PRIME_URL itself, and
# those are preferred; this is the local override, and it must be the origin
# Stripe should send people back to.
SITE_ORIGIN=http://localhost:3000
